<mxfile host="app.diagrams.net" type="device">
  <diagram id="d1" name="1. Kiến trúc">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;Kiến trúc backend — website công ty bếp ga / ga / thiết bị ga&lt;/b&gt;&lt;br&gt;Monolith Django + Next.js trên 1 VPS, Docker Compose. Ngôn ngữ: vi / en / km. Địa lý: Việt Nam (sẵn chỗ cho quốc gia khác)." style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="-90" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Khách truy cập&lt;/b&gt;&lt;br&gt;mobile / desktop&lt;br&gt;vi · en · km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Admin công ty&lt;/b&gt;&lt;br&gt;1 role Admin&lt;br&gt;(mật khẩu + 2FA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Bạn — người bảo trì&lt;/b&gt;&lt;br&gt;tài khoản admin riêng&lt;br&gt;+ SSH key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Cloudflare&lt;/b&gt; (gói Free)&lt;br&gt;• DNS cho tên miền &lt;b&gt;.vn&lt;/b&gt;&lt;br&gt;• CDN cache trang + ảnh&lt;br&gt;• WAF, chống DDoS&lt;br&gt;• Turnstile (chống spam form)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="160" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="VPS tại Việt Nam — 2 vCPU / 4 GB RAM / 80 GB SSD — Ubuntu 24.04 LTS — Docker Compose&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;UFW: chỉ mở 80/443 (từ IP Cloudflare) + SSH (key, không password)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="780" height="620" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;reverse proxy, HTTPS&lt;br&gt;&lt;br&gt;/ → nextjs&lt;br&gt;/api/*, /admin/* → django" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="590" y="190" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Next.js&lt;/b&gt; (SSR / ISR)&lt;br&gt;/vi · /en · /km&lt;br&gt;sitemap.xml, hreflang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="90" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Django + DRF&lt;/b&gt; (Gunicorn)&lt;br&gt;• /api/v1 — REST + OpenAPI&lt;br&gt;• /admin — Django Admin (Unfold)&lt;br&gt;• import/export Excel&lt;br&gt;• audit log (simple-history)&lt;br&gt;&lt;br&gt;&lt;i&gt;apps: catalog · geo · dealers · content · jobs · forms · warranty · i18n · site · media&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="220" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Worker&lt;/b&gt; (django-q2)&lt;br&gt;hàng đợi nằm trong Postgres&lt;br&gt;• gửi email thông báo&lt;br&gt;• resize / nén ảnh&lt;br&gt;• geocode địa chỉ đại lý&lt;br&gt;• dịch máy vi → en/km&lt;br&gt;• chạy import Excel lớn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;pg_trgm · unaccent&lt;br&gt;jsonb + GIN" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="240" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;Backup&lt;/b&gt; (cron container)&lt;br&gt;pg_dump hằng ngày&lt;br&gt;giữ 7 ngày · 4 tuần · 6 tháng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="545" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Object storage&lt;/b&gt; (Cloudflare R2)&lt;br&gt;• bucket &lt;b&gt;public&lt;/b&gt;: ảnh, PDF catalogue&lt;br&gt;&amp;nbsp;&amp;nbsp;qua media.&amp;lt;tenmien&amp;gt;.vn&lt;br&gt;• bucket &lt;b&gt;private&lt;/b&gt;: CV, hoá đơn&lt;br&gt;&amp;nbsp;&amp;nbsp;chỉ tải bằng signed URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="20" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Kho backup ngoài VPS&lt;/b&gt;&lt;br&gt;bucket R2 riêng (hoặc nhà cung cấp khác)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="160" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Email giao dịch&lt;/b&gt; (Brevo / Resend)&lt;br&gt;gửi từ noreply@&amp;lt;tenmien&amp;gt;.vn&lt;br&gt;(SPF + DKIM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="250" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Hộp mail công ty&lt;/b&gt;&lt;br&gt;nhận thông báo form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="255" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Dịch máy&lt;/b&gt;&lt;br&gt;Google Translate API hoặc LLM API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="350" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;Bản đồ &amp;amp; geocoding&lt;/b&gt; (Goong / Google)&lt;br&gt;trình duyệt tải tile trực tiếp;&lt;br&gt;worker gọi geocode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="435" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Giám sát&lt;/b&gt;&lt;br&gt;UptimeRobot (web sập) + Sentry (lỗi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="535" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;repo + Actions: test → build image&lt;br&gt;→ GHCR → SSH deploy&lt;br&gt;(docker compose pull &amp;amp;&amp;amp; up -d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="520" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="HTTPS /admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6">
