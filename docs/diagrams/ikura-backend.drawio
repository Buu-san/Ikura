        <mxCell id="e30" value="lấy job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;entryX=0.2;entryY=1;" edge="1" parent="1" source="c11" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e31" value="đẩy job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="pg_dump" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="c13" target="c12">
          <mxGeometry relative="1" as="geometry" />
