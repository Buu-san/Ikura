        <mxCell id="e33" value="offsite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="c13" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" value="upload / signed URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" value="ảnh public qua CDN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e40" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" value="deploy (SSH)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;entryX=0.3;entryY=1;" edge="1" parent="1" source="c21" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;1. Mọi form lưu vào DB &lt;b&gt;trước&lt;/b&gt;, email chỉ là thông báo (gửi lỗi thì worker gửi lại).&lt;br&gt;2. Next.js gọi Django qua mạng Docker nội bộ; trình duyệt chỉ gọi /api cho form, bộ lọc, tìm kiếm.&lt;br&gt;3. Không Redis, không search engine riêng, không microservice — thêm khi có số liệu chứng minh cần.&lt;br&gt;4. App không giữ trạng thái (file ở R2, config qua env) → tách thêm server khi cần scale.&lt;br&gt;5. Mỗi quý thử khôi phục backup ít nhất 1 lần." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="780" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d44" name="2. Database (ERD)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c45" value="&lt;b&gt;ERD — PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;code&gt;xxx_{vi,en,km}&lt;/code&gt; = 3 cột theo ngôn ngữ (django-modeltranslation). Mọi bảng nghiệp vụ có thêm bảng lịch sử &lt;code&gt;history_&amp;lt;bảng&amp;gt;&lt;/code&gt; (django-simple-history: history_user_id, history_date, history_type).&lt;br&gt;FK tới bảng dùng chung (&lt;b&gt;auth_user, media_file, import_batch&lt;/b&gt;) chỉ ghi tên đích trong cột, không vẽ đường để đỡ rối. Ký hiệu đường: chân gà = nhiều, gạch = một, vòng tròn = có thể null." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="0" y="-110" width="1900" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="GEO — Đơn vị hành chính" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fillColor=#f3f9f1;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="690" height="346" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="geo_country" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="280" height="118" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;PK&lt;/b&gt;&amp;nbsp; &lt;b&gt;id &lt;font color=&quot;#666666&quot;&gt;: bigint&lt;/font&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c47">
          <mxGeometry x="0" y="30" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;UQ&lt;/b&gt;&amp;nbsp; code &lt;font color=&quot;#666666&quot;&gt;: char(2)  'VN'&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c47">
          <mxGeometry x="0" y="52" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;name_{vi,en,km} &lt;font color=&quot;#666666&quot;&gt;: varchar&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c47">
          <mxGeometry x="0" y="74" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active &lt;font color=&quot;#666666&quot;&gt;: bool&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c47">
          <mxGeometry x="0" y="96" width="280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c52" value="geo_unit_mapping" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;fontSize=13;" vertex="1" parent="1">
