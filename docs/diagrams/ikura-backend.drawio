          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" value="/api/*, /admin/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="SSR fetch nội bộ&lt;br&gt;http://django:8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c9" target="c10">
