        <mxCell id="e24" value="origin HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
