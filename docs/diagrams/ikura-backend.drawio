  <diagram id="f3" name="3. Luồng: Publish → revalidate">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f3t" value="&lt;b&gt;Luồng 3 — Publish nội dung → cập nhật trang công khai&lt;/b&gt;&lt;br&gt;Áp dụng cho sản phẩm, danh mục, bài viết, trang tĩnh, tin tuyển dụng, đại lý, site_section. Không có hẹn giờ đăng ở giai đoạn 1." style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="2010" height="70" as="geometry" /></mxCell>
        <mxCell id="f3l0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="2010" height="103" as="geometry" /></mxCell>
        <mxCell id="f3h0" value="&lt;b&gt;Admin công ty&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="150" height="103" as="geometry" /></mxCell>
        <mxCell id="f3l1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="103" width="2010" height="118" as="geometry" /></mxCell>
        <mxCell id="f3h1" value="&lt;b&gt;Django&lt;/b&gt;&lt;br&gt;Admin + API" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="103" width="150" height="118" as="geometry" /></mxCell>
        <mxCell id="f3l2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="221" width="2010" height="118" as="geometry" /></mxCell>
        <mxCell id="f3h2" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="221" width="150" height="118" as="geometry" /></mxCell>
        <mxCell id="f3l3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="339" width="2010" height="150" as="geometry" /></mxCell>
        <mxCell id="f3h3" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;django-q2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="339" width="150" height="150" as="geometry" /></mxCell>
        <mxCell id="f3l4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="489" width="2010" height="118" as="geometry" /></mxCell>
        <mxCell id="f3h4" value="&lt;b&gt;Next.js&lt;/b&gt;&lt;br&gt;ISR cache" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="489" width="150" height="118" as="geometry" /></mxCell>
        <mxCell id="f3l5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="607" width="2010" height="103" as="geometry" /></mxCell>
        <mxCell id="f3h5" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;CDN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="607" width="150" height="103" as="geometry" /></mxCell>
        <mxCell id="f3l6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="2010" height="133" as="geometry" /></mxCell>
        <mxCell id="f3h6" value="&lt;b&gt;Khách truy cập&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="150" height="133" as="geometry" /></mxCell>
        <mxCell id="f3a1" value="&lt;b&gt;1 ·&lt;/b&gt; Soạn / sửa trong /admin (bản vi bắt buộc), bấm &lt;b&gt;Publish&lt;/b&gt; (hoặc Unpublish / Xoá)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f3a2" value="&lt;b&gt;2 ·&lt;/b&gt; Validate form admin: slug không trùng, đủ trường bắt buộc, có ảnh chính (sản phẩm)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="123" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3a3" value="&lt;b&gt;3 ·&lt;/b&gt; 1 transaction: UPDATE bản ghi (status, published_at) + INSERT history_&amp;lt;bảng&amp;gt; (simple-history)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="241" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3a4" value="&lt;b&gt;4 ·&lt;/b&gt; transaction.on_commit → xếp job &lt;code&gt;revalidate&lt;/code&gt; (và job dịch nếu bản vi đổi → trang 5)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="910" y="123" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3a5" value="&lt;b&gt;5 ·&lt;/b&gt; Tính tag bị ảnh hưởng: &lt;code&gt;post:42&lt;/code&gt; · &lt;code&gt;posts&lt;/code&gt; · &lt;code&gt;nav&lt;/code&gt; · &lt;code&gt;sitemap&lt;/code&gt; (+ &lt;code&gt;home&lt;/code&gt; nếu is_featured)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1140" y="375" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3a6" value="&lt;b&gt;6 ·&lt;/b&gt; POST /api/revalidate (header secret) → revalidateTag(...) → bỏ cache ISR cho /vi /en /km" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1370" y="509" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3d1" value="Next.js trả 200?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1610" y="359" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="f3a7" value="&lt;b&gt;7 ·&lt;/b&gt; Purge các URL bị ảnh hưởng qua Cloudflare API (purge by URL — có ở gói Free)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1600" y="627" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f3x1" value="&lt;b&gt;Lỗi:&lt;/b&gt; retry 3 lần (30s · 2m · 10m); vẫn lỗi → Sentry. Lưới an toàn: ISR tự làm mới sau 1 giờ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1830" y="375" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f3a8" value="&lt;b&gt;8 ·&lt;/b&gt; Request kế tiếp: Cloudflare miss → Next.js render bản mới (SSR fetch http://django:8000/api/v1) → cache lại" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1830" y="730" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f3e0" value="Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3a1" target="f3a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3a2" target="f3a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e2" value="commit OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3a3" target="f3a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e3" value="lỗi validate → báo ngay trên form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="f3a2" target="f3a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e4" value="job (hàng đợi trong Postgres)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f3a4" target="f3a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e5" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f3a5" target="f3a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e6" value="HTTP status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3a6" target="f3d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e7" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3d1" target="f3a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e8" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="f3d1" target="f3x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f3a7" target="f3a8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3lg" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;── mũi tên liền: gọi đồng bộ (chờ kết quả)&lt;br&gt;- - mũi tên nét đứt: bất đồng bộ (job trong hàng đợi / webhook)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;- - đỏ: nhánh lỗi&lt;/font&gt;&lt;br&gt;◇ điểm rẽ nhánh" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="873" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="f3nt" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;1. Job revalidate chỉ được xếp &lt;b&gt;sau khi commit&lt;/b&gt; → Next.js không bao giờ đọc dữ liệu cũ vì race.&lt;br&gt;2. Dùng &lt;b&gt;tag&lt;/b&gt; thay vì liệt kê path: 1 tag phủ cả 3 ngôn ngữ và mọi trang liệt kê bản ghi đó. Tag &lt;code&gt;nav&lt;/code&gt; làm mới menu → mục trống tự ẩn theo site_section.&lt;br&gt;3. Unpublish / Xoá đi cùng luồng này: trang chi tiết trả 404, bản ghi rời khỏi danh sách và sitemap. Đổi slug → tự tạo seo_redirect 301 từ slug cũ.&lt;br&gt;4. Xem trước bản nháp: nút &lt;b&gt;Xem trước&lt;/b&gt; trong admin mở Next.js Draft Mode bằng token ký (hết hạn 10 phút), không qua cache Cloudflare và không làm bẩn ISR.&lt;br&gt;5. Secret của webhook revalidate và API token Cloudflare (quyền chỉ Cache Purge) nằm trong env, không nằm trong DB." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="873" width="1660" height="118" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="f4" name="4. Luồng: Form → DB → email">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f4t" value="&lt;b&gt;Luồng 4 — Form công khai → lưu DB → email thông báo&lt;/b&gt;&lt;br&gt;4 loại form: Liên hệ · Đăng ký đại lý · Đăng ký bảo hành · Ứng tuyển. Nguyên tắc: lưu DB trước, email chỉ là thông báo." style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="2930" height="70" as="geometry" /></mxCell>
        <mxCell id="f4l0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="2930" height="103" as="geometry" /></mxCell>
        <mxCell id="f4h0" value="&lt;b&gt;Khách truy cập&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="150" height="103" as="geometry" /></mxCell>
        <mxCell id="f4l1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="103" width="2930" height="133" as="geometry" /></mxCell>
        <mxCell id="f4h1" value="&lt;b&gt;Trang form&lt;/b&gt;&lt;br&gt;Next.js (trình duyệt)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="103" width="150" height="133" as="geometry" /></mxCell>
        <mxCell id="f4l2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="2930" height="100" as="geometry" /></mxCell>
        <mxCell id="f4h2" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;Turnstile" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="f4l3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="2930" height="133" as="geometry" /></mxCell>
        <mxCell id="f4h3" value="&lt;b&gt;Django API&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="150" height="133" as="geometry" /></mxCell>
        <mxCell id="f4l4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="469" width="2930" height="178" as="geometry" /></mxCell>
        <mxCell id="f4h4" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="469" width="150" height="178" as="geometry" /></mxCell>
        <mxCell id="f4l5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="647" width="2930" height="100" as="geometry" /></mxCell>
        <mxCell id="f4h5" value="&lt;b&gt;R2 private&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="647" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="f4l6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="2930" height="150" as="geometry" /></mxCell>
        <mxCell id="f4h6" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;django-q2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="150" height="150" as="geometry" /></mxCell>
        <mxCell id="f4l7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="897" width="2930" height="100" as="geometry" /></mxCell>
        <mxCell id="f4h7" value="&lt;b&gt;Brevo / Resend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="897" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="f4l8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="997" width="2930" height="133" as="geometry" /></mxCell>
        <mxCell id="f4h8" value="&lt;b&gt;Công ty&lt;/b&gt;&lt;br&gt;hộp mail + /admin" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="997" width="150" height="133" as="geometry" /></mxCell>
        <mxCell id="f4b1" value="&lt;b&gt;1 ·&lt;/b&gt; Điền form, tick &lt;b&gt;đồng ý xử lý dữ liệu cá nhân&lt;/b&gt;; Turnstile chạy ngầm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f4b2" value="&lt;b&gt;2 ·&lt;/b&gt; Kiểm tra phía client, gửi POST /api/v1/forms/{type} (multipart): dữ liệu + file CV/hoá đơn ≤ 5 MB + turnstile_token + ô honeypot ẩn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="123" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f4b3" value="&lt;b&gt;3 ·&lt;/b&gt; Chặn sớm: honeypot phải trống; rate limit theo ip_hash (5 lần / 10 phút)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="371" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f4b4" value="&lt;b&gt;4 ·&lt;/b&gt; siteverify turnstile_token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="910" y="258" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4b5" value="&lt;b&gt;5 ·&lt;/b&gt; Validate theo type (serializer, payload); file: kiểm tra magic bytes (pdf / jpg / png / docx) và dung lượng" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1140" y="356" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f4x1" value="&lt;b&gt;400 / 429&lt;/b&gt; → hiện lỗi theo ngôn ngữ, giữ nguyên dữ liệu đã nhập" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="910" y="138" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f4b6" value="&lt;b&gt;6 ·&lt;/b&gt; Upload file, key ngẫu nhiên, không có URL public" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1140" y="669" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4b7" value="&lt;b&gt;7 ·&lt;/b&gt; 1 transaction: forms_submission (status=new, locale, consent_at, retention_until, ip_hash) + bảng mở rộng (warranty_registration / jobs_application) + media_file + forms_notification_log (queued)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1600" y="489" width="190" height="138" as="geometry" /></mxCell>
        <mxCell id="f4b8" value="&lt;b&gt;8 ·&lt;/b&gt; on_commit → xếp job gửi mail; trả &lt;b&gt;201&lt;/b&gt; + mã tham chiếu" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1830" y="371" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f4b9" value="&lt;b&gt;9 ·&lt;/b&gt; Hiện “Cảm ơn — mã #…” theo ngôn ngữ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2060" y="142" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4w1" value="&lt;b&gt;10 ·&lt;/b&gt; Render template theo type, gửi tới site_settings.notify_email. Chỉ tóm tắt + link /admin/…/&amp;lt;id&amp;gt;, &lt;b&gt;không&lt;/b&gt; đính kèm CV/hoá đơn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2060" y="776" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f4w2" value="&lt;b&gt;11 ·&lt;/b&gt; Gửi từ noreply@&amp;lt;tenmien&amp;gt;.vn (SPF + DKIM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2290" y="919" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4d1" value="Gửi OK?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2530" y="767" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="f4w3" value="&lt;b&gt;12a ·&lt;/b&gt; log: status=sent, provider_msg_id, sent_at" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2520" y="530" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4x2" value="&lt;b&gt;12b ·&lt;/b&gt; attempts+1, retry 1m · 5m · 30m · 2h · 6h; quá 5 lần → status=failed + Sentry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2750" y="783" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f4m1" value="&lt;b&gt;13 ·&lt;/b&gt; Hộp mail công ty nhận thông báo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2290" y="1036" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f4m2" value="&lt;b&gt;14 ·&lt;/b&gt; Xử lý trong /admin: new → in_progress → done / spam. Bảo hành: pending → approved (warranty_until) / rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2750" y="1017" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f4e0" value="Gửi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b1" target="f4b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e1" value="HTTPS /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b2" target="f4b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b3" target="f4b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e3" value="hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b4" target="f4b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e4" value="có file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f4b5" target="f4b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b6" target="f4b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e6" value="không file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="f4b5" target="f4b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e7" value="chặn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="f4b3" target="f4x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e8" value="token sai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="f4b4" target="f4x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e9" value="sai dữ liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="f4b5" target="f4x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e10" value="commit OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b7" target="f4b8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e11" value="201" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4b8" target="f4b9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e12" value="job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f4b8" target="f4w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4w1" target="f4w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e14" value="kết quả API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4w2" target="f4d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e15" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4d1" target="f4w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e16" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="f4d1" target="f4x2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e17" value="email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f4w2" target="f4m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e18" value="bấm link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4m1" target="f4m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4e19" value="form luôn có trong /admin dù email lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="f4w3" target="f4m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4lg" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;── mũi tên liền: gọi đồng bộ (chờ kết quả)&lt;br&gt;- - mũi tên nét đứt: bất đồng bộ (job trong hàng đợi / webhook)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;- - đỏ: nhánh lỗi&lt;/font&gt;&lt;br&gt;◇ điểm rẽ nhánh" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="f4nt" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;1. Email lỗi không làm mất form: bản ghi đã nằm trong DB từ bước 7, admin luôn thấy trong danh sách “chưa xử lý”.&lt;br&gt;2. Khách có nhập email → thêm 1 dòng forms_notification_log gửi email xác nhận cho khách (theo locale), cùng cơ chế retry.&lt;br&gt;3. File CV / hoá đơn chỉ tải qua /admin bằng signed URL (hết hạn 5 phút). Email không bao giờ chứa file hay dữ liệu nhạy cảm.&lt;br&gt;4. Job hằng ngày: submission quá &lt;b&gt;retention_until&lt;/b&gt; → xoá file trên R2 + ẩn danh họ tên / SĐT / email (giữ số liệu thống kê).&lt;br&gt;5. Bảo hành giai đoạn 1 chỉ đăng ký: serial_text lưu nguyên văn, serial_id để trống. Tra cứu serial là giai đoạn 2.&lt;br&gt;6. ip_hash = sha256(IP + salt trong env) → rate limit được mà không lưu IP thật." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="1160" width="2580" height="133" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="f5" name="5. Luồng: Dịch máy vi → en/km">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f5t" value="&lt;b&gt;Luồng 5 — Dịch máy tiếng Việt → English / ខ្មែរ&lt;/b&gt;&lt;br&gt;Bản vi là nguồn. Mỗi (bản ghi, ngôn ngữ) có 1 dòng i18n_translation_status: missing → machine → approved." style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="2700" height="70" as="geometry" /></mxCell>
        <mxCell id="f5l0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="2700" height="118" as="geometry" /></mxCell>
        <mxCell id="f5h0" value="&lt;b&gt;Admin công ty&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="150" height="118" as="geometry" /></mxCell>
        <mxCell id="f5l1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="2700" height="150" as="geometry" /></mxCell>
        <mxCell id="f5h1" value="&lt;b&gt;Django Admin&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="150" height="150" as="geometry" /></mxCell>
        <mxCell id="f5l2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="2700" height="118" as="geometry" /></mxCell>
        <mxCell id="f5h2" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="150" height="118" as="geometry" /></mxCell>
        <mxCell id="f5l3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="2700" height="150" as="geometry" /></mxCell>
        <mxCell id="f5h3" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;django-q2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="150" height="150" as="geometry" /></mxCell>
        <mxCell id="f5l4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="2700" height="100" as="geometry" /></mxCell>
        <mxCell id="f5h4" value="&lt;b&gt;Dịch máy&lt;/b&gt;&lt;br&gt;Google / LLM API" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="f5l5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="2700" height="133" as="geometry" /></mxCell>
        <mxCell id="f5h5" value="&lt;b&gt;API công khai&lt;/b&gt;&lt;br&gt;+ Next.js" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="150" height="133" as="geometry" /></mxCell>
        <mxCell id="f5t1" value="&lt;b&gt;1 ·&lt;/b&gt; Nhập / sửa nội dung tiếng Việt (các cột &lt;code&gt;*_vi&lt;/code&gt;) → Lưu hoặc Publish" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="28" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f5t2" value="&lt;b&gt;2 ·&lt;/b&gt; Tính source_hash = sha256(mọi cột &lt;code&gt;*_vi&lt;/code&gt; cần dịch của bản ghi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="162" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f5d1" value="hash khác bản đã dịch?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="138" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="f5n1" value="Xong, không dịch lại (vd chỉ đổi sort_order, giá, ảnh)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="31" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f5d2" value="bản dịch hiện tại đã approved?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="138" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="f5s1" value="Giữ bản dịch cũ, đánh dấu &lt;b&gt;lỗi thời&lt;/b&gt; (hash lệch) → admin thấy cảnh báo + nút “Dịch lại”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="910" y="288" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f5q1" value="&lt;b&gt;3 ·&lt;/b&gt; on_commit → xếp job translate(obj, en) và translate(obj, km). Đã có job đang chờ cho cùng obj + locale thì không xếp thêm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1140" y="146" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f5w1" value="&lt;b&gt;4 ·&lt;/b&gt; Đọc bản vi + ghi nhớ hash lúc bắt đầu. Rich text: giữ nguyên thẻ HTML. Glossary: thương hiệu, SKU, đơn vị (kg, kW, mbar) không dịch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1370" y="414" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f5api" value="&lt;b&gt;5 ·&lt;/b&gt; Dịch vi → en và vi → km" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1600" y="558" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f5x1" value="&lt;b&gt;Lỗi / timeout:&lt;/b&gt; retry 3 lần; vẫn lỗi → giữ status cũ, báo Sentry; admin bấm “Dịch lại” sau" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1600" y="422" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f5d3" value="hash vi hiện tại vẫn = hash lúc bắt đầu?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1840" y="406" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="f5x2" value="Bỏ kết quả (admin đã sửa tiếp, job mới đã được xếp)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2060" y="433" width="190" height="56" as="geometry" /></mxCell>
        <mxCell id="f5w2" value="&lt;b&gt;6 ·&lt;/b&gt; Ghi &lt;code&gt;*_en&lt;/code&gt; / &lt;code&gt;*_km&lt;/code&gt;; status=&lt;b&gt;machine&lt;/b&gt;, engine, source_hash, updated_at" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2060" y="296" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f5w3" value="&lt;b&gt;7 ·&lt;/b&gt; Bản ghi đang published → xếp job revalidate (luồng 3)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2290" y="430" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f5r1" value="&lt;b&gt;8 ·&lt;/b&gt; Màn “Bản dịch cần duyệt”: lọc status=machine, ưu tiên is_safety → sửa → bấm &lt;b&gt;Duyệt&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2290" y="20" width="190" height="78" as="geometry" /></mxCell>
        <mxCell id="f5r2" value="&lt;b&gt;9 ·&lt;/b&gt; status=&lt;b&gt;approved&lt;/b&gt;, approved_by, approved_at; source_hash = hash hiện tại" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2520" y="296" width="190" height="63" as="geometry" /></mxCell>
        <mxCell id="f5v1" value="&lt;b&gt;10 ·&lt;/b&gt; Trả locale km/en khi: có nội dung VÀ (approved HOẶC (machine VÀ không is_safety)). Không đạt → fallback en → vi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2520" y="656" width="190" height="93" as="geometry" /></mxCell>
        <mxCell id="f5e0" value="Lưu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5t1" target="f5t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5t2" target="f5d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e2" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5d1" target="f5n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e3" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5d1" target="f5d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e4" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5d2" target="f5s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e5" value="Không (missing / machine)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5d2" target="f5q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e6" value="admin bấm Dịch lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="f5s1" target="f5q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e7" value="job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f5q1" target="f5w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="f5w1" target="f5api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e9" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="f5api" target="f5x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e10" value="bản dịch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="f5api" target="f5d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e11" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="f5d3" target="f5w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e12" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f5d3" target="f5x2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5w2" target="f5w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e14" value="revalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="f5w3" target="f5v1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e15" value="Duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f5r1" target="f5r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5e16" value="revalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f5r2" target="f5v1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5lg" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;── mũi tên liền: gọi đồng bộ (chờ kết quả)&lt;br&gt;- - mũi tên nét đứt: bất đồng bộ (job trong hàng đợi / webhook)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;- - đỏ: nhánh lỗi&lt;/font&gt;&lt;br&gt;◇ điểm rẽ nhánh" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="799" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="f5nt" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Không bao giờ ghi đè bản đã approved&lt;/b&gt;: người đã duyệt thì chỉ người bấm “Dịch lại” mới thay.&lt;br&gt;2. Nội dung &lt;b&gt;is_safety&lt;/b&gt; (hướng dẫn an toàn gas, xử lý rò rỉ): bản dịch máy vẫn lưu nhưng không hiện cho khách cho tới khi được duyệt. Chưa duyệt → khách xem en hoặc vi.&lt;br&gt;3. SEO: hreflang và sitemap chỉ liệt kê ngôn ngữ thực sự hiển thị. Trang đang fallback gắn canonical về bản gốc để tránh nội dung trùng lặp.&lt;br&gt;4. Chi phí: chỉ dịch khi hash đổi và gộp job trùng → sửa vặt nhiều lần vẫn chỉ tốn 1 lượt dịch cho mỗi ngôn ngữ.&lt;br&gt;5. Engine (Google / LLM) chọn qua env, ghi vào cột engine để so chất lượng tiếng Khmer về sau." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="799" width="2350" height="118" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
